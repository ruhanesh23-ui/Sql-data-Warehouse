-- ============================================================
-- Script  : Gold Layer — Dimension and Fact View Definitions
-- Schema  : gold (aggregated / business layer)
-- Purpose : Creates business-ready views for reporting and
--           analytics by joining and integrating cleansed
--           Silver layer tables.
-- Views   :
--   - gold.dim_customer  : Customer dimension (SCD Type 0)
--   - gold.dim_products  : Product dimension (active only)
--   - gold.fact_sales    : Sales fact table
-- Notes   :
--   - Surrogate keys generated with ROW_NUMBER()
--   - All views are built on top of Silver layer tables
--   - No data is stored — views query Silver on every call
-- ============================================================


-- ============================================================
-- VIEW 1: gold.dim_customer
-- ============================================================
-- Builds the customer dimension by integrating three Silver
-- tables:
--   - silver.crm_cust_info  : Core customer attributes
--                             (name, marital status, gender)
--   - silver.erp_CUST_AZ12  : ERP demographics
--                             (birth date, gender supplement)
--   - silver.erp_LOC_A101   : ERP location data (country)
--
-- Key logic:
--   - Surrogate key  : ROW_NUMBER() ordered by cst_id generates
--                      a unique integer key for each customer,
--                      decoupling the warehouse key from the
--                      source system ID.
--   - Gender resolve : CRM gender is preferred as the primary
--                      source. ERP gender is used as a fallback
--                      only when CRM value is 'n/a' (unknown).
--                      COALESCE ensures a final 'n/a' default
--                      if both sources are missing.
--   - Joins          : LEFT JOIN preserves all CRM customers
--                      even if no matching ERP record exists.
-- ============================================================

CREATE VIEW gold.dim_customer AS
SELECT
    -- Surrogate key: unique integer assigned to each customer.
    -- Ordered by cst_id for deterministic, consistent assignment.
    ROW_NUMBER() OVER (ORDER BY ci.cst_id) AS customer_key,

    ci.cst_id           AS customer_id,      -- Source system customer ID (CRM)
    ci.cst_key          AS customer_number,  -- Business/natural key from CRM
    ci.cst_firstname    AS first_name,       -- Cleansed first name (trimmed in Silver)
    ci.cst_lastname     AS last_name,        -- Cleansed last name (trimmed in Silver)
    la.CNTRY            AS country,          -- Country from ERP location table
    ci.cst_marital_status AS marital_status, -- Decoded marital status (e.g. 'Married')

    -- Gender Resolution: CRM is the master source for gender.
    -- If CRM gender is 'n/a' (unknown/missing), fall back to
    -- the ERP gender value. If ERP is also missing, default to 'n/a'.
    CASE 
        WHEN ci.cst_gndr <> 'n/a' THEN ci.cst_gndr       -- CRM value is known — use it
        ELSE COALESCE(ca.GEN, 'n/a')                      -- Fall back to ERP, then 'n/a'
    END AS gender,

    ca.BDATE            AS birthdate,    -- Birth date from ERP demographics
    ci.cst_create_date  AS create_date   -- Date customer record was created in CRM

FROM silver.crm_cust_info ci

-- Join ERP demographics to enrich with birth date and gender.
-- LEFT JOIN: keep all CRM customers even if no ERP match exists.
LEFT JOIN silver.erp_CUST_AZ12 ca
    ON ci.cst_key = ca.CID   -- CRM business key matches ERP customer ID

-- Join ERP location to enrich with country.
-- LEFT JOIN: keep all CRM customers even if no location record exists.
LEFT JOIN silver.erp_LOC_A101 la
    ON ci.cst_key = la.CID;  -- CRM business key matches ERP location ID


-- ============================================================
-- VIEW 2: gold.dim_products
-- ============================================================
-- Builds the product dimension by joining two Silver tables:
--   - silver.crm_prd_info      : Core product attributes
--                                (key, name, cost, line, dates)
--   - silver.erp_PX_CAT_G1V2  : ERP product category hierarchy
--                                (category, subcategory, maintenance)
--
-- Key logic:
--   - Surrogate key    : ROW_NUMBER() ordered by start date and
--                        product key for deterministic assignment.
--   - Active only      : WHERE prd_end_dt IS NULL filters to
--                        only currently active product versions.
--                        Historical/expired versions are excluded
--                        from the dimension to avoid double-counting
--                        in fact table joins.
--   - Category join    : cat_id (derived in Silver from prd_key)
--                        links to the ERP category table ID.
-- ============================================================

CREATE VIEW gold.dim_products AS
SELECT
    -- Surrogate key: unique integer assigned to each product.
    -- Ordered by start date then product key for consistency.
    ROW_NUMBER() OVER (ORDER BY pm.prd_start_dt, pm.prd_key) AS product_key,

    pm.prd_id       AS product_id,      -- Source system product ID
    pm.prd_key      AS product_number,  -- Cleansed product business key
    pm.prd_nm       AS product_name,    -- Product name from CRM
    pm.cat_id       AS category_id,     -- Category ID derived from product key in Silver

    pc.CAT          AS category,        -- Top-level category name from ERP
    pc.SUBCAT       AS subcategory,     -- Subcategory name from ERP
    pc.MAINTENANCE,                     -- Maintenance classification from ERP

    pm.prd_cost     AS cost,            -- Product unit cost (NULLs defaulted to 0 in Silver)
    pm.prd_line     AS product_line,    -- Decoded product line (e.g. 'Mountain', 'Road')
    pm.prd_start_dt AS start_date       -- Date this product version became active

FROM silver.crm_prd_info pm

-- Join ERP category table to enrich with category hierarchy.
-- LEFT JOIN: keep all products even if no category match exists.
LEFT JOIN silver.erp_PX_CAT_G1V2 pc
    ON pm.cat_id = pc.ID  -- Silver cat_id matches ERP category ID

-- Filter to active product versions only.
-- prd_end_dt IS NULL means this is the current/latest version —
-- no subsequent version exists to end-date it.
-- Expired versions (prd_end_dt IS NOT NULL) are excluded to
-- prevent duplicate product matches in fact table joins.
WHERE pm.prd_end_dt IS NULL;


-- ============================================================
-- VIEW 3: gold.fact_sales
-- ============================================================
-- Builds the central sales fact table by joining the Silver
-- sales transactions table to the Gold dimension views.
--
-- Key logic:
--   - Grain          : One row per sales order line item.
--   - Measures       : sls_sales, sls_quantity, sls_price
--                      (all validated and derived in Silver).
--   - Dimension keys : Surrogate keys from dim_customer and
--                      dim_products replace source IDs,
--                      decoupling the fact table from source
--                      system keys.
--   - Join to dims   : sls_prd_key → product_number (dim_products)
--                      sls_cust_id → customer_id (dim_customer)
--   - LEFT JOIN      : Preserves all sales records even if a
--                      dimension record is missing (orphan facts),
--                      which are caught by the integrity check below.
-- ============================================================

CREATE VIEW gold.fact_sales AS
SELECT
    sd.sls_ord_num,      -- Sales order number (natural key)
    pr.product_key,      -- Surrogate key from gold.dim_products
    cu.customer_key,     -- Surrogate key from gold.dim_customer
    sd.sls_order_dt,     -- Order date (validated/cast to DATE in Silver)
    sd.sls_ship_dt,      -- Shipment date (validated/cast to DATE in Silver)
    sd.sls_due_dt,       -- Payment due date (validated/cast to DATE in Silver)
    sd.sls_sales,        -- Total sales amount (derived/validated in Silver)
    sd.sls_quantity,     -- Order line quantity
    sd.sls_price         -- Unit price (derived/validated in Silver)

FROM silver.crm_sales_details sd

-- Join to product dimension to resolve product surrogate key.
-- Matches on the cleansed product business key from Silver.
LEFT JOIN gold.dim_products pr
    ON sd.sls_prd_key = pr.product_number

-- Join to customer dimension to resolve customer surrogate key.
-- Matches on the source system customer ID from Silver.
LEFT JOIN gold.dim_customer cu
    ON sd.sls_cust_id = cu.customer_id;


-- ============================================================
-- INTEGRITY CHECK: Foreign key validation
-- ============================================================
-- Verifies referential integrity between the fact table and
-- both dimension tables after the views are created.
-- Identifies any fact rows where the dimension join failed —
-- meaning a sales record references a product or customer
-- that does not exist in the corresponding dimension.
--
-- Expectation: this query returns NO rows.
-- If rows are returned:
--   - NULL product_key : sales record has no matching product
--                        in dim_products (possible expired/missing product)
--   - NULL customer_key: sales record has no matching customer
--                        in dim_customer (possible missing CRM record)

SELECT *
FROM gold.fact_sales f

-- Re-join dimensions to check for broken foreign key references.
LEFT JOIN gold.dim_customer c
    ON c.customer_key = f.customer_key

LEFT JOIN gold.dim_products p
    ON p.product_key = f.product_key

-- Filter to only rows where a dimension join produced no match.
-- These are orphan fact records that would cause gaps in reports.
WHERE p.product_key IS NULL;  -- Expand to: OR c.customer_key IS NULL
                               -- if you also want to catch missing customers
